# =============================================================================
# DoonFlow — Variables de entorno de ejemplo
# Ver docs/setup-supabase.md para instrucciones paso a paso.
#
# Copiar como .env.local (raíz) y packages/db/.env (para migraciones).
# NUNCA commitear archivos .env o .env.local con valores reales.
# =============================================================================

# ── Base de datos (Supabase Postgres) ─────────────────────────────────────────
# Transaction mode (puerto 6543) — usado por Prisma para queries normales.
# Supabase Dashboard → Settings → Database → Connection String → Transaction mode
DATABASE_URL=postgresql://postgres.XXXX:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Session mode (puerto 5432) — usado por Prisma para migraciones (requiere conexión directa).
# Supabase Dashboard → Settings → Database → Connection String → Session mode
DIRECT_URL=postgresql://postgres.XXXX:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase Dashboard → Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co

# Supabase Dashboard → Settings → Data API → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Dashboard → Settings → Data API → service_role  ⚠ MANTENER PRIVADA
# Solo para apps/api (servidor), nunca exponer en el cliente/browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── apps/api ──────────────────────────────────────────────────────────────────
# Puerto en que escucha la API Express.
PORT=4000

# Origen permitido en CORS (URL del frontend).
WEB_ORIGIN=http://localhost:3000

# ── Autenticación (solo modo LOCAL, sin Supabase Auth — ver LocalAuthAdapter) ──
# Secreto de firma del JWT propio. Generar uno fuerte en producción (nunca el valor de ejemplo).
JWT_SECRET=cambiar-por-un-secreto-fuerte-en-produccion

# Expiración de sesión (010-seguridad-privacidad-continuidad, HU-1): formato de `ms` (ej. "30m",
# "8h", "1d"). Al expirar, el usuario debe reautenticarse — no hay renovación silenciosa
# indefinida (regla de negocio 4 del spec). Default en código: "8h" si se omite esta variable.
JWT_EXPIRES_IN=8h

# ── Retención de datos (010-seguridad-privacidad-continuidad) ─────────────────
# Expresión cron del job de purgado por política de retención (ver job-purgar-retencion.job.ts).
# Default en código: "0 3 * * *" (diario, 3am) si se omite esta variable.
RETENCION_JOB_CRON="0 3 * * *"
