// Esquema base de DoonFlow — módulo Usuarios y Roles (multiempresa).
// Ver CLAUDE.md → "Base de datos" y "Arquitectura: Hexagonal".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Empresa — raíz del aislamiento multiempresa. Toda tabla de dominio cuelga de empresa_id.
model Empresa {
  id          String   @id @default(uuid())
  nombre      String
  activa      Boolean  @default(true)
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  usuarios  Usuario[]
  clientes  Cliente[]

  @@map("empresa")
}

/// Rol — catálogo fijo (ver packages/shared/src/constants/roles.ts).
/// No se crean roles nuevos sin pasar por agente-arquitecto.
model Rol {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  usuarios     Usuario[]
  rolPermisos  RolPermiso[]

  @@map("rol")
}

/// Permiso — acción granular que puede otorgarse a un rol.
model Permiso {
  id          String   @id @default(uuid())
  codigo      String   @unique
  descripcion String?
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  rolPermisos RolPermiso[]

  @@map("permiso")
}

/// Tabla puente rol↔permiso.
model RolPermiso {
  rolId     String @map("rol_id")
  permisoId String @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

/// Usuario de la plataforma.
/// passwordHash: solo en desarrollo local (sin Supabase Auth). En producción con Supabase este campo es nulo.
model Usuario {
  id           String   @id @default(uuid())
  empresaId    String   @map("empresa_id")
  authUserId   String?  @unique @map("auth_user_id")  // null en modo local
  email        String   @unique
  nombre       String
  rolId        String   @map("rol_id")
  passwordHash String?  @map("password_hash")         // solo desarrollo local
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  sucursalId   String?  @map("sucursal_id")
  clienteId    String?  @map("cliente_id")

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  rol      Rol       @relation(fields: [rolId], references: [id])
  sucursalPrincipal Sucursal? @relation("SucursalPrincipal", fields: [sucursalId], references: [id])
  accesosSucursal   UsuarioSucursalAcceso[]
  cliente  Cliente?  @relation(fields: [clienteId], references: [id])
  plantillasSolicitadas InspeccionPlantilla[] @relation("PlantillaSolicitante")
  plantillasAprobadas   InspeccionPlantilla[] @relation("PlantillaAprobador")
  registrosAuditoria    RegistroAuditoria[]
  avisosPrivacidadRegistrados AvisoPrivacidad[]
  reportesGenerados     ReporteGenerado[]
  importacionesCreadas  ImportacionLote[]
  certificacionesFirmadas Inspeccion[] @relation("InspeccionFirmadoPor")
  /// 013-hallazgos-plan-cumplimiento
  accionesResponsable   AccionCorrectiva[] @relation("AccionesResponsable")
  accionesVerificadas   AccionCorrectiva[] @relation("AccionesVerificadas")
  planesCerrados        PlanCumplimiento[] @relation("PlanesCerrados")

  @@index([empresaId])
  @@index([sucursalId])
  @@index([empresaId, clienteId])
  @@map("usuario")
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO: CLIENTES
// Personas de contacto y empresas registradas para uso en Mantenimientos.
// ═══════════════════════════════════════════════════════════════════════════

/// Cliente — empresa o persona responsable de contacto.
model Cliente {
  id                    String   @id @default(uuid())
  empresaId             String   @map("empresa_id")
  nombreResponsable     String   @map("nombre_responsable") @db.VarChar(200)
  empresa               String   @db.VarChar(200)
  identificacionEmpresa String?  @map("identificacion_empresa") @db.VarChar(50)
  correo1               String   @db.VarChar(150)
  correo2               String?  @db.VarChar(150)
  correo3               String?  @db.VarChar(150)
  direccion             String?  @db.VarChar(300)
  movil                 String?  @db.VarChar(20)
  activo                Boolean  @default(true)
  creadoEn              DateTime @default(now()) @map("creado_en")
  actualizadoEn         DateTime @updatedAt @map("actualizado_en")

  empresaRel Empresa    @relation(fields: [empresaId], references: [id])
  sucursales Sucursal[]
  usuarios   Usuario[]

  @@index([empresaId, activo])
  @@index([empresaId, creadoEn])
  @@map("cliente")
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO: SUCURSALES
// Cada Cliente (empresa) tiene N Sucursales; la certificación BPM se ejecuta
// y lleva histórico por sucursal, no por cliente.
// ═══════════════════════════════════════════════════════════════════════════

/// Sucursal — planta/establecimiento físico de un Cliente, unidad de certificación.
model Sucursal {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  clienteId     String   @map("cliente_id")
  nombre        String   @db.VarChar(150)
  direccion     String?  @db.VarChar(300)
  correo        String?  @db.VarChar(150)
  movil         String?  @db.VarChar(20)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  usuarios Usuario[] @relation("SucursalPrincipal")
  accesos  UsuarioSucursalAcceso[]
  inspecciones Inspeccion[]

  @@index([empresaId, clienteId, activo])
  @@map("sucursal")
}

/// Tabla puente — sucursales adicionales de consulta para un usuario (además de su sucursal principal).
model UsuarioSucursalAcceso {
  usuarioId  String   @map("usuario_id")
  sucursalId String   @map("sucursal_id")
  creadoEn   DateTime @default(now()) @map("creado_en")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@id([usuarioId, sucursalId])
  @@map("usuario_sucursal_acceso")
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO: INSPECCIONES (RF-01 a RF-14)
// Arquitectura genérica de n-niveles: PANEL (sección) | PREGUNTA (hoja).
// Cualquier número de niveles sin cambios de código.
// Ejemplo real: Apartado → Subapartado → Sub-subapartado → Categoría → Ítem
// ═══════════════════════════════════════════════════════════════════════════

enum TipoInspeccion {
  MINISTERIO_SALUD
  AUDITORIA_INTERNA
  CALIDAD
  SEGURIDAD_OCUPACIONAL
  SUPERVISION_OPERATIVA
  OTRO
}

/// PANEL = sección con hijos (título de nivel); PREGUNTA = hoja con respuesta.
enum TipoNodo {
  PANEL
  PREGUNTA
}

enum TipoRespuesta {
  SI_NO
  SELECCION_UNICA
  SELECCION_MULTIPLE
  TEXTO_LIBRE
  NUMERICO
  PUNTAJE_MANUAL
}

enum ModalidadPuntaje {
  FIJO
  PARCIAL
  MANUAL
  POR_OPCIONES
}

enum ReglaComentario {
  NUNCA
  SIEMPRE
  CUANDO_NEGATIVO
  CUANDO_PUNTAJE_MENOR_MAXIMO
  CONFIGURABLE
}

/// RF-01 — Plantilla de inspección
model InspeccionPlantilla {
  id              String         @id @default(uuid())
  empresaId       String         @map("empresa_id")
  nombre          String
  descripcion     String?
  tipo            TipoInspeccion
  activa          Boolean        @default(true)
  puntajeMaximo   Decimal        @default(100) @map("puntaje_maximo") @db.Decimal(8, 2)
  fechaVigencia   DateTime?      @map("fecha_vigencia") @db.Date
  observaciones   String?
  version         Int            @default(1)
  creadoEn        DateTime       @default(now()) @map("creado_en")
  actualizadoEn   DateTime       @updatedAt @map("actualizado_en")
  creadoPorId     String?        @map("creado_por_id")

  /// 007-gobernanza-permisos-aprobacion — flujo borrador → en revisión → aprobada/rechazada,
  /// condición adicional (no reemplaza `activa`) para poder iniciar una certificación nueva.
  estadoAprobacion     EstadoAprobacionPlantilla @default(BORRADOR) @map("estado_aprobacion")
  solicitadoPorId      String?   @map("solicitado_por_id")
  solicitadoEn         DateTime? @map("solicitado_en")
  aprobadorId          String?   @map("aprobador_id")
  resueltoEn           DateTime? @map("resuelto_en")
  comentarioResolucion String?   @map("comentario_resolucion")

  nodos           InspeccionNodo[]
  rangosResultado InspeccionRangoResultado[]
  inspecciones    Inspeccion[]
  auditorias      InspeccionAuditoria[]
  solicitante Usuario? @relation("PlantillaSolicitante", fields: [solicitadoPorId], references: [id])
  aprobador   Usuario? @relation("PlantillaAprobador", fields: [aprobadorId], references: [id])

  @@index([empresaId, activa])
  @@index([empresaId, estadoAprobacion])
  @@map("inspeccion_plantilla")
}

/// 007-gobernanza-permisos-aprobacion
enum EstadoAprobacionPlantilla {
  BORRADOR
  EN_REVISION
  APROBADA
  RECHAZADA
}

/// RF-02/03/04 — Nodo genérico de n niveles: PANEL (sección con hijos) | PREGUNTA (hoja)
///
/// Ejemplo estructura Ministerio de Salud:
///   nivel 0: PANEL "1. EDIFICIO"
///   nivel 1: PANEL "1.1 PLANTA Y SUS ALREDEDORES"
///   nivel 2: PANEL "1.1.1 ALREDEDORES"
///   nivel 3: PANEL "a) Limpios"
///   nivel 4: PREGUNTA "i) Almacenamiento adecuado del equipo en desuso."
///
/// La UI construye el árbol recursivamente a partir de padre_id.
model InspeccionNodo {
  id               String            @id @default(uuid())
  empresaId        String            @map("empresa_id")
  plantillaId      String            @map("plantilla_id")
  padreId          String?           @map("padre_id")        // null = nodo raíz de la plantilla
  tipo             TipoNodo
  codigo           String            // ej: "1", "1.1", "1.1.1", "a", "i"
  titulo           String            // Para PANEL: encabezado de sección; Para PREGUNTA: texto de la pregunta
  criterio         String?           // Texto de criterio de evaluación (columna D del formulario MS)
  orden            Int               @default(0)
  nivel            Int               @default(0)             // profundidad (0 = raíz)
  // Solo para tipo PREGUNTA:
  tipoRespuesta    TipoRespuesta?    @map("tipo_respuesta")
  modalidadPuntaje ModalidadPuntaje? @map("modalidad_puntaje")
  puntajeMaximo    Decimal           @default(0) @map("puntaje_maximo") @db.Decimal(8, 2)
  reglaComentario  ReglaComentario   @default(NUNCA) @map("regla_comentario")
  umbralComentario Decimal?          @map("umbral_comentario") @db.Decimal(8, 2)
  evidenciaObligatoria Boolean       @default(false) @map("evidencia_obligatoria")
  evidenciaMinima  Int               @default(0) @map("evidencia_minima")
  evidenciaMaxima  Int               @default(5) @map("evidencia_maxima")
  activo           Boolean           @default(true)
  creadoEn         DateTime          @default(now()) @map("creado_en")
  actualizadoEn    DateTime          @updatedAt @map("actualizado_en")

  plantilla  InspeccionPlantilla @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  padre      InspeccionNodo?     @relation("JerarquiaNodo", fields: [padreId], references: [id], onDelete: Cascade)
  hijos      InspeccionNodo[]    @relation("JerarquiaNodo")
  opciones   InspeccionNodoOpcion[]
  detalles   InspeccionDetalle[]

  @@index([plantillaId, orden])
  @@index([padreId])
  @@map("inspeccion_nodo")
}

/// RF-04/05 — Opción de respuesta de un nodo PREGUNTA
model InspeccionNodoOpcion {
  id          String   @id @default(uuid())
  nodoId      String   @map("nodo_id")
  etiqueta    String   // ej: "Cumple todos los requisitos"
  criterio    String?  // descripción de cuándo aplica esta opción
  puntaje     Decimal  @default(0) @db.Decimal(8, 2)
  orden       Int      @default(0)
  creadoEn    DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  nodo InspeccionNodo @relation(fields: [nodoId], references: [id], onDelete: Cascade)

  @@index([nodoId, orden])
  @@map("inspeccion_nodo_opcion")
}

/// RF-10 — Rango de clasificación del resultado por plantilla
model InspeccionRangoResultado {
  id            String   @id @default(uuid())
  plantillaId   String   @map("plantilla_id")
  desde         Decimal  @db.Decimal(5, 2)
  hasta         Decimal  @db.Decimal(5, 2)
  clasificacion String
  color         String   @default("#6B7280")
  orden         Int      @default(0)
  creadoEn      DateTime @default(now()) @map("creado_en")

  plantilla InspeccionPlantilla @relation(fields: [plantillaId], references: [id], onDelete: Cascade)

  @@index([plantillaId])
  @@map("inspeccion_rango_resultado")
}

// ── OPERACIÓN ────────────────────────────────────────────────────────────────

/// RF-08 — Cabecera de una inspección ejecutada
model Inspeccion {
  id                     String    @id @default(uuid())
  empresaId              String    @map("empresa_id")
  plantillaId            String    @map("plantilla_id")
  plantillaVersion       Int       @map("plantilla_version")
  inspectorId            String    @map("inspector_id")
  sucursalId             String?   @map("sucursal_id")
  /// @deprecated reemplazado por `sucursalId` (sprint 015-wizard-certificacion) — se conserva por historial, no se elimina.
  establecimiento        String?
  periodoEtiqueta        String?   @map("periodo_etiqueta") @db.VarChar(50)
  fechaInicio            DateTime  @map("fecha_inicio")
  fechaFin               DateTime? @map("fecha_fin")
  estado                 String    @default("EN_PROGRESO")
  puntajeObtenido        Decimal   @default(0) @map("puntaje_obtenido") @db.Decimal(8, 2)
  puntajeMaximo          Decimal   @default(0) @map("puntaje_maximo") @db.Decimal(8, 2)
  porcentajeCumplimiento Decimal   @default(0) @map("porcentaje_cumplimiento") @db.Decimal(5, 2)
  clasificacion          String?
  observaciones          String?
  capturaOffline         Boolean   @default(false) @map("captura_offline")
  sincronizadoEn         DateTime? @map("sincronizado_en")
  creadoEn               DateTime  @default(now()) @map("creado_en")
  actualizadoEn          DateTime  @updatedAt @map("actualizado_en")

  /// 005-certificacion-plan-cumplimiento (retomado 2026-07-21) — HU-2, firma/PDF/código de verificación.
  firmadoPorId    String?   @map("firmado_por_id")
  firmadoEn       DateTime? @map("firmado_en")
  codigoVerificacion String? @unique @map("codigo_verificacion") @db.VarChar(20)
  pdfUrl          String?   @map("pdf_url")
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date
  resultadoFinal  String?   @map("resultado_final") @db.VarChar(30)

  plantilla      InspeccionPlantilla    @relation(fields: [plantillaId], references: [id])
  sucursal       Sucursal?                @relation(fields: [sucursalId], references: [id])
  firmadoPor     Usuario?                 @relation("InspeccionFirmadoPor", fields: [firmadoPorId], references: [id])
  detalles       InspeccionDetalle[]
  evidencias     InspeccionEvidencia[]
  reinspecciones InspeccionReinspeccion[]
  /// 013-hallazgos-plan-cumplimiento
  hallazgos        Hallazgo[]
  planCumplimiento PlanCumplimiento?

  @@index([empresaId, estado])
  @@index([plantillaId])
  @@index([sucursalId])
  @@index([empresaId, sucursalId, estado, creadoEn])
  @@index([sucursalId, fechaInicio])
  @@index([empresaId, capturaOffline])
  @@map("inspeccion")
}

/// RF-08 — Detalle: una fila por nodo PREGUNTA respondido.
/// Guarda snapshot de la ruta jerárquica (RF-14: las inspecciones históricas
/// conservan la estructura vigente al momento de su ejecución).
model InspeccionDetalle {
  id                  String   @id @default(uuid())
  inspeccionId        String   @map("inspeccion_id")
  nodoId              String   @map("nodo_id")
  // Snapshot de la ruta completa al momento de la inspección
  rutaCodigos         String   @map("ruta_codigos")      // "1|1.1|1.1.1|a|i"
  rutaTitulos         String   @map("ruta_titulos")      // "EDIFICIO|PLANTA...|ALREDEDORES|Limpios|Almacenamiento..."
  preguntaTitulo      String   @map("pregunta_titulo")   // snapshot del texto de la pregunta
  criterioSnapshot    String?  @map("criterio_snapshot") // snapshot del criterio
  tipoRespuesta       String   @map("tipo_respuesta")
  respuestaValor      String?  @map("respuesta_valor")
  respuestasMultiples String[] @map("respuestas_multiples")
  puntajeObtenido     Decimal  @default(0) @map("puntaje_obtenido") @db.Decimal(8, 2)
  puntajeMaximo       Decimal  @default(0) @map("puntaje_maximo") @db.Decimal(8, 2)
  comentario          String?
  creadoEn            DateTime @default(now()) @map("creado_en")
  actualizadoEn       DateTime @updatedAt @map("actualizado_en")

  inspeccion Inspeccion     @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  nodo       InspeccionNodo @relation(fields: [nodoId], references: [id])
  evidencias InspeccionEvidencia[]
  hallazgos  Hallazgo[]

  @@index([inspeccionId])
  @@map("inspeccion_detalle")
}

/// RF-07 — Evidencia adjunta
model InspeccionEvidencia {
  id           String   @id @default(uuid())
  inspeccionId String   @map("inspeccion_id")
  detalleId    String?  @map("detalle_id")
  tipo         String
  url          String
  nombre       String
  tamanoBytes  Int?     @map("tamano_bytes")
  creadoEn     DateTime @default(now()) @map("creado_en")

  inspeccion Inspeccion         @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  detalle    InspeccionDetalle? @relation(fields: [detalleId], references: [id])

  @@index([inspeccionId])
  @@map("inspeccion_evidencia")
}

/// RF-11 — Reinspección
model InspeccionReinspeccion {
  id                     String   @id @default(uuid())
  inspeccionId           String   @map("inspeccion_id")
  numero                 Int
  fecha                  DateTime
  inspectorId            String   @map("inspector_id")
  comentarios            String?
  puntajeObtenido        Decimal  @default(0) @map("puntaje_obtenido") @db.Decimal(8, 2)
  porcentajeCumplimiento Decimal  @default(0) @map("porcentaje_cumplimiento") @db.Decimal(5, 2)
  creadoEn               DateTime @default(now()) @map("creado_en")

  inspeccion Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)

  @@index([inspeccionId])
  @@map("inspeccion_reinspeccion")
}

// ═══════════════════════════════════════════════════════════════════════════
// 013-hallazgos-plan-cumplimiento — Hallazgos y plan de cumplimiento (Parte B
// de 005-certificacion-plan-cumplimiento, dividido por tamaño).
// ═══════════════════════════════════════════════════════════════════════════

/// Incumplimiento detectado en una certificación — automático (desde una respuesta con
/// puntaje incompleto) o manual (agregado por el auditor durante la revisión).
model Hallazgo {
  id           String   @id @default(uuid())
  inspeccionId String   @map("inspeccion_id")
  detalleId    String?  @map("detalle_id")
  descripcion  String
  severidad    String   @db.VarChar(20) // CRITICA | MAYOR | MENOR
  empresaId    String   @map("empresa_id")
  creadoEn     DateTime @default(now()) @map("creado_en")

  inspeccion Inspeccion          @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  detalle    InspeccionDetalle?  @relation(fields: [detalleId], references: [id])
  evidencias HallazgoEvidencia[]
  acciones   AccionCorrectiva[]

  @@index([inspeccionId])
  @@index([empresaId, severidad])
  @@map("hallazgo")
}

/// Evidencia adjunta al momento de detectar un hallazgo (mismo patrón que `InspeccionEvidencia`).
model HallazgoEvidencia {
  id          String   @id @default(uuid())
  hallazgoId  String   @map("hallazgo_id")
  tipo        String
  url         String
  nombre      String
  tamanoBytes Int?     @map("tamano_bytes")
  creadoEn    DateTime @default(now()) @map("creado_en")

  hallazgo Hallazgo @relation(fields: [hallazgoId], references: [id], onDelete: Cascade)

  @@index([hallazgoId])
  @@map("hallazgo_evidencia")
}

/// Cabecera del plan de cumplimiento de una certificación — se crea cuando hay ≥1 hallazgo.
model PlanCumplimiento {
  id           String    @id @default(uuid())
  inspeccionId String    @unique @map("inspeccion_id")
  estado       String    @default("EN_SEGUIMIENTO") @db.VarChar(20) // EN_SEGUIMIENTO | CERRADO | REABIERTO
  cerradoPorId String?   @map("cerrado_por_id")
  cerradoEn    DateTime? @map("cerrado_en")
  creadoEn     DateTime  @default(now()) @map("creado_en")

  inspeccion Inspeccion         @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  cerradoPor Usuario?           @relation("PlanesCerrados", fields: [cerradoPorId], references: [id])
  acciones   AccionCorrectiva[]

  @@map("plan_cumplimiento")
}

/// Acción correctiva de un hallazgo dentro de un plan de cumplimiento.
model AccionCorrectiva {
  id                     String    @id @default(uuid())
  planCumplimientoId     String    @map("plan_cumplimiento_id")
  hallazgoId             String    @map("hallazgo_id")
  descripcion            String
  responsableId          String    @map("responsable_id")
  fechaLimite            DateTime  @map("fecha_limite") @db.Date
  estado                 String    @default("PENDIENTE") @db.VarChar(20)
  porcentajeAvance       Int       @default(0) @map("porcentaje_avance")
  verificadoPorId        String?   @map("verificado_por_id")
  verificadoEn           DateTime? @map("verificado_en")
  comentarioVerificacion String?   @map("comentario_verificacion")
  creadoEn               DateTime  @default(now()) @map("creado_en")
  actualizadoEn          DateTime  @updatedAt @map("actualizado_en")

  planCumplimiento PlanCumplimiento            @relation(fields: [planCumplimientoId], references: [id], onDelete: Cascade)
  hallazgo         Hallazgo                    @relation(fields: [hallazgoId], references: [id])
  responsable      Usuario                     @relation("AccionesResponsable", fields: [responsableId], references: [id])
  verificadoPor    Usuario?                    @relation("AccionesVerificadas", fields: [verificadoPorId], references: [id])
  evidencias       AccionCorrectivaEvidencia[]

  @@index([planCumplimientoId])
  @@index([hallazgoId])
  @@index([responsableId, estado])
  @@index([fechaLimite])
  @@map("accion_correctiva")
}

/// Evidencia de avance cargada por el responsable de una acción correctiva.
model AccionCorrectivaEvidencia {
  id                 String   @id @default(uuid())
  accionCorrectivaId String   @map("accion_correctiva_id")
  tipo               String
  url                String
  nombre             String
  comentario         String?
  creadoEn           DateTime @default(now()) @map("creado_en")

  accionCorrectiva AccionCorrectiva @relation(fields: [accionCorrectivaId], references: [id], onDelete: Cascade)

  @@index([accionCorrectivaId])
  @@map("accion_correctiva_evidencia")
}

/// RF-12 — Auditoría de cambios en configuración
model InspeccionAuditoria {
  id           String   @id @default(uuid())
  plantillaId  String?  @map("plantilla_id")
  usuarioId    String   @map("usuario_id")
  tabla        String
  registroId   String   @map("registro_id")
  accion       String
  valorAntes   Json?    @map("valor_antes")
  valorDespues Json?    @map("valor_despues")
  creadoEn     DateTime @default(now()) @map("creado_en")

  plantilla InspeccionPlantilla? @relation(fields: [plantillaId], references: [id])

  @@index([plantillaId])
  @@index([usuarioId])
  @@map("inspeccion_auditoria")
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO: SEGURIDAD, PRIVACIDAD Y CONTINUIDAD (010-seguridad-privacidad-continuidad)
// Auditoría transversal, política de retención y aviso de privacidad.
// ═══════════════════════════════════════════════════════════════════════════

/// RegistroAuditoria — generaliza InspeccionAuditoria a acciones críticas de todo el sistema
/// (login, cambios de permisos, desactivaciones, purgado por retención). Append-only: el
/// puerto de repositorio (`RegistroAuditoriaRepositoryPort`) nunca expone `actualizar`/`eliminar`.
model RegistroAuditoria {
  id           String   @id @default(uuid())
  empresaId    String   @map("empresa_id")
  usuarioId    String   @map("usuario_id")
  accion       String   @db.VarChar(50)
  entidadTipo  String   @map("entidad_tipo") @db.VarChar(50)
  entidadId    String   @map("entidad_id")
  valorAntes   Json?    @map("valor_antes")
  valorDespues Json?    @map("valor_despues")
  ip           String?  @db.VarChar(45)
  creadoEn     DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, accion, creadoEn(sort: Desc)])
  @@index([usuarioId])
  @@index([entidadTipo, entidadId])
  @@map("registro_auditoria")
}

/// PoliticaRetencion — cuánto tiempo se conserva cada tipo de dato antes de anonimizar/eliminar.
/// Una fila por (empresaId, tipoDato); ver seed `politica-retencion-demo.ts` para valores de ejemplo.
model PoliticaRetencion {
  id              String   @id @default(uuid())
  empresaId       String   @map("empresa_id")
  tipoDato        String   @map("tipo_dato") @db.VarChar(30)
  mesesRetencion  Int      @map("meses_retencion")
  accionAlVencer  String   @map("accion_al_vencer") @db.VarChar(20)
  actualizadoEn   DateTime @updatedAt @map("actualizado_en")

  @@unique([empresaId, tipoDato])
  @@map("politica_retencion")
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO: INTEGRACIONES Y DATOS MASIVOS (009-integraciones-datos-masivos)
// Solo HU-1/HU-2 (importación masiva de Cliente/Sucursal) — HU-3 (API keys +
// verificación pública) queda pospuesta: depende de codigoVerificacion/
// fechaVencimiento (005, pausado) y del portal /verificar/[codigo] (006, sin
// código todavía). Decisión del usuario 2026-07-21, ver memoria/decisiones.md.
// ═══════════════════════════════════════════════════════════════════════════

enum TipoImportacion {
  CLIENTE
  SUCURSAL
}

/// ImportacionLote — trazabilidad de cada carga masiva de Cliente/Sucursal.
model ImportacionLote {
  id             String           @id @default(uuid())
  tipo           TipoImportacion
  archivoNombre  String           @map("archivo_nombre") @db.VarChar(255)
  totalFilas     Int              @map("total_filas")
  filasExitosas  Int              @map("filas_exitosas")
  filasConError  Int              @map("filas_con_error")
  detalleErrores Json?            @map("detalle_errores")
  creadoPorId    String           @map("creado_por_id")
  creadoEn       DateTime         @default(now()) @map("creado_en")
  empresaId      String           @map("empresa_id")

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])

  @@index([empresaId, tipo, creadoEn])
  @@map("importacion_lote")
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO: REPORTES Y ANALYTICS (008-reportes-analytics)
// Reportes agregados (consolidado por cliente / comparativo entre sucursales),
// exportables a Excel/PDF, con historial de generación.
// ═══════════════════════════════════════════════════════════════════════════

enum TipoReporte {
  CONSOLIDADO_CLIENTE
  COMPARATIVO_SUCURSALES
}

enum FormatoReporte {
  EXCEL
  PDF
}

/// ReporteGenerado — archivo exportable (Excel/PDF) ya calculado y guardado.
/// No se recalcula al abrir el historial; cada generación crea una fila nueva (nunca se borra).
model ReporteGenerado {
  id            String         @id @default(uuid())
  empresaId     String         @map("empresa_id")
  tipo          TipoReporte
  filtros       Json           // snapshot: clienteId, sucursalIds?, fechaDesde, fechaHasta
  formato       FormatoReporte
  url           String         // ubicación en Supabase Storage (o filesystem local en modo LOCAL)
  generadoPorId String         @map("generado_por_id")
  creadoEn      DateTime       @default(now()) @map("creado_en")

  generadoPor Usuario @relation(fields: [generadoPorId], references: [id])

  @@index([empresaId, creadoEn(sort: Desc)])
  @@index([empresaId, tipo])
  @@map("reporte_generado")
}

/// AvisoPrivacidad — constancia de bajo qué base legal se tratan los datos de contacto de un
/// Cliente/Sucursal (los ingresa un administrador, no el titular). No es un consentimiento firmado.
model AvisoPrivacidad {
  id              String   @id @default(uuid())
  entidadTipo     String   @map("entidad_tipo") @db.VarChar(20)
  entidadId       String   @map("entidad_id")
  baseLegal       String   @map("base_legal")
  registradoPorId String   @map("registrado_por_id")
  empresaId       String   @map("empresa_id")
  creadoEn        DateTime @default(now()) @map("creado_en")

  registradoPor Usuario @relation(fields: [registradoPorId], references: [id])

  @@index([entidadTipo, entidadId])
  @@map("aviso_privacidad")
}
